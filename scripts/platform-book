#!/bin/sh
# Select the provisioned venv even when an installed shim prepends base Python.
set -eu
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -z "${VIRTUAL_ENV:-}" ]; then
  echo "platform-book: activate the provisioned Python venv" >&2
  exit 2
fi
if [ ! -x "$VIRTUAL_ENV/bin/python3" ]; then
  echo "platform-book: activated VIRTUAL_ENV has no Python interpreter" >&2
  exit 2
fi
interpreter="$VIRTUAL_ENV/bin/python3"
# macOS system launchers discard DYLD_*; accept an explicit provisioned native
# library search path and set it only when directly executing the interpreter.
if [ -n "${PLATFORM_BOOK_LIBRARY_PATH:-}" ]; then
  export DYLD_FALLBACK_LIBRARY_PATH="$PLATFORM_BOOK_LIBRARY_PATH"
fi
exec "$interpreter" "$script_dir/platform_book.py" "$@"
