{
  "schema_version": 3,
  "runtime_roots": [
    "scripts",
    "assets"
  ],
  "commands": {
    "platform-book": {
      "type": "script",
      "unix_path": "scripts/platform-book"
    }
  },
  "capabilities": {
    "network": "none",
    "filesystem": "repo",
    "exec": [
      "python3",
      "pandoc"
    ],
    "secrets": "none",
    "env_read": [
      "VIRTUAL_ENV",
      "PLATFORM_BOOK_LIBRARY_PATH"
    ]
  },
  "dependencies": {
    "commands": {
      "python3": {
        "type": "system",
        "command": "python3",
        "hint": "Activate a Python 3.12.15 venv containing requirements-lock.txt and provision native Pango libraries (README)."
      },
      "pandoc": {
        "type": "system",
        "command": "pandoc",
        "hint": "Provision pandoc 3.11."
      }
    }
  }
}
